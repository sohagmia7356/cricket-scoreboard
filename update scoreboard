<!doctype html>
<html lang="bn">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Live Cricket Scoreboard</title>
<style>
*{box-sizing:border-box}body{margin:0;background:#07111f;color:#fff;font-family:Arial,sans-serif}
.wrap{max-width:620px;margin:auto;padding:14px}.card{background:#111d2e;border:1px solid #263852;border-radius:18px;overflow:hidden}
.head{text-align:center;padding:18px;background:#0c1727}.live{font-weight:800;color:#ff5757}.small{color:#9dacbf;font-size:13px;margin-top:6px}
.form{padding:14px;border-bottom:1px solid #263852}.form input{width:100%;padding:13px;margin-bottom:9px;border-radius:10px;border:1px solid #354963;background:#091423;color:#fff;font-size:15px}
.form button{width:100%;padding:13px;border:0;border-radius:10px;background:#2878ff;color:#fff;font-weight:800;font-size:15px}
.status{text-align:center;padding:11px;color:#aebbd0;font-size:13px}.error{display:none;color:#ff8585;text-align:center;padding:0 14px 12px}
.team{display:flex;justify-content:space-between;align-items:center;padding:18px;border-top:1px solid #263852}
.teamname{font-size:19px;font-weight:700}.score{font-size:28px;font-weight:800}.info,.section{padding:15px 18px;border-top:1px solid #263852}
.title{font-size:12px;color:#8fa0b7;margin-bottom:9px}.row{display:flex;justify-content:space-between;padding:7px 0}
.ball{display:inline-block;background:#273a56;border-radius:7px;padding:6px 9px;margin:3px;font-size:13px}
.hint{color:#7f90a8;font-size:12px;line-height:1.5;padding:14px}
</style>
</head>
<body>
<div class="wrap"><div class="card">
  <div class="head"><div class="live">🔴 LIVE CRICKET</div><div class="small">CricLive API Scoreboard</div></div>

  <div class="form">
    <input id="token" type="password" placeholder="আপনার API Token (Bearer token)">
    <input id="matchId" placeholder="Match ID লিখুন">
    <button onclick="start()">LOAD MATCH</button>
  </div>

  <div id="status" class="status">API Token ও Match ID দিয়ে LOAD MATCH চাপুন</div>
  <div id="error" class="error"></div>

  <div class="team"><span id="team1" class="teamname">Team 1</span><span id="score1" class="score">—</span></div>
  <div class="team"><span id="team2" class="teamname">Team 2</span><span id="score2" class="score">—</span></div>

  <div class="info">Overs: <b id="overs">—</b></div>

  <div class="section">
    <div class="title">CURRENT BATTERS</div>
    <div class="row"><span id="b1">—</span><b id="b1r">—</b></div>
    <div class="row"><span id="b2">—</span><b id="b2r">—</b></div>
  </div>

  <div class="section">
    <div class="title">BOWLER</div>
    <div class="row"><span id="bowler">—</span><b id="bowlerfig">—</b></div>
  </div>

  <div class="section">
    <div class="title">LAST BALL / COMMENTARY</div>
    <div id="lastball">—</div>
  </div>

  <div class="hint">
    Match ID বদলালে নতুন ম্যাচ LOAD করতে পারবেন। স্কোরবোর্ড প্রতি 10 সেকেন্ডে আপডেট হবে।
    API token এই পেজে না রেখে server-side রাখা বেশি নিরাপদ।
  </div>
</div></div>

<script>
let timer=null;

function setText(id,v){
  document.getElementById(id).textContent =
    v===undefined || v===null || v==="" ? "—" : String(v);
}

function pick(obj, paths){
  for(const path of paths){
    let v=obj;
    for(const k of path.split(".")){
      if(v==null) break;
      v=v[k];
    }
    if(v!==undefined && v!==null && v!=="") return v;
  }
  return null;
}

function normalize(data){
  const root=data?.data ?? data;
  const m=root?.match ?? root;
  const teams=m?.teams;

  let t1=pick(m,["first_team","team1","teams.0"]);
  let t2=pick(m,["second_team","team2","teams.1"]);

  if(!t1 && Array.isArray(teams)) t1=teams[0];
  if(!t2 && Array.isArray(teams)) t2=teams[1];

  return {
    t1:t1?.name ?? t1?.full_name ?? t1 ?? "Team 1",
    s1:t1?.score ?? pick(m,["score1"]),
    t2:t2?.name ?? t2?.full_name ?? t2 ?? "Team 2",
    s2:t2?.score ?? pick(m,["score2"]),
    overs:pick(m,["overs","current_overs","score.overs"]),
    b1:pick(m,["current_batsmen.0.name","batsmen.0.name","current_batsman.name"]),
    b1r:pick(m,["current_batsmen.0.runs","batsmen.0.runs","current_batsman.runs"]),
    b2:pick(m,["current_batsmen.1.name","batsmen.1.name"]),
    b2r:pick(m,["current_batsmen.1.runs","batsmen.1.runs"]),
    bowler:pick(m,["current_bowler.name","bowler.name"]),
    bowlerfig:pick(m,["current_bowler.figures","bowler.figures","current_bowler"]),
    last:pick(m,["last_ball","lastBall","commentary.0.text","commentary.0.description"])
  };
}

function render(data){
  const x=normalize(data);
  setText("team1",x.t1);setText("score1",x.s1);
  setText("team2",x.t2);setText("score2",x.s2);
  setText("overs",x.overs);setText("b1",x.b1);setText("b1r",x.b1r);
  setText("b2",x.b2);setText("b2r",x.b2r);
  setText("bowler",x.bowler);setText("bowlerfig",x.bowlerfig);
  setText("lastball",x.last);
}

async function load(){
  const token=document.getElementById("token").value.trim();
  const id=document.getElementById("matchId").value.trim();
  const status=document.getElementById("status");
  const error=document.getElementById("error");

  if(!token || !id){
    error.style.display="block";
    error.textContent="API Token এবং Match ID—দুটিই দিতে হবে।";
    return;
  }

  error.style.display="none";
  status.textContent="Live score loading...";

  try{
    const url="https://cricketliveapi.com/api/v1/match/"+encodeURIComponent(id)+"/scorecard";
    const res=await fetch(url,{
      headers:{
        "Authorization":"Bearer "+token,
        "Accept":"application/json"
      }
    });
    const text=await res.text();
    let data;
    try{data=JSON.parse(text)}catch{throw new Error("API JSON response দেয়নি")}
    if(!res.ok) throw new Error("HTTP "+res.status+" — "+(data.message||"API request failed"));
    render(data);
    status.textContent="Updated: "+new Date().toLocaleTimeString();
  }catch(e){
    console.error(e);
    status.textContent="Update failed";
    error.style.display="block";
    error.textContent=e.message+" — CORS/API permission থাকলেও সমস্যা হতে পারে।";
  }
}

function start(){
  clearInterval(timer);
  load();
  timer=setInterval(load,10000);
}
</script>
</body>
</html>
